# Committed fixture for the end-to-end suite.
#
# This fixture lets `npm run test:e2e` run without machine-specific setup.
# Playwright passes it to Wrangler with --env-file, so a developer's .dev.vars
# is neither read nor changed.
#
# These values are throwaway: the suite runs against its own local D1/R2 state
# (see playwright.config.ts) and never talks to a real deployment.
# Left unset on purpose: the app takes the origin from the request, and local
# requests (127.0.0.1:4173) still count as local for SKIP_TOTP below.
# APP_URL=http://localhost:4173
APP_NAME=CogSend

# Deliberately fake (64 hex chars), and listed in the placeholder guard inside
# src/lib/server/env.ts. AUTH_SECRET and SCHEDULER_SECRET are left unset on
# purpose so the suite exercises the derived path a fresh deployment takes.
APP_ENCRYPTION_KEY=deadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeef

# The login is not here: the account is created in D1 by scripts/seed-local.mjs,
# into the suite's own state directory, before the server starts.

# Several specs sign in with a password only, so the run skips 2FA enrollment.
# Honored only for a localhost APP_URL in a non-production build.
SKIP_TOTP=1
